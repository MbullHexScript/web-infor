APP_NAME="Website Program Studi Informatika"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging-informatika.uinbanten.ac.id
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=informatika_staging
DB_USERNAME=informatika_staging
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=staging-informatika.uinbanten.ac.id
SESSION_SAME_SITE=lax
SESSION_COOKIE=informatika_staging_session

CACHE_STORE=database
CACHE_PREFIX=informatika_staging_
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

SINTESA_API_URL=https://staging-sintesa.uinbanten.ac.id/api/integration.php
SINTESA_API_TOKEN=
SINTESA_API_TIMEOUT=15

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=informatika@uinbanten.ac.id
MAIL_FROM_NAME="Program Studi Informatika"

ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

BACKUP_DISK=local
BACKUP_ENCRYPTION_KEY=

CLOUDFLARE_ENABLED=false
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

ANALYTICS_PROVIDER=
ANALYTICS_ID=

CAPTCHA_ENABLED=false
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

APP_MAINTENANCE_SECRET=
HSTS_PRELOAD=false
VITE_APP_NAME="${APP_NAME}"
